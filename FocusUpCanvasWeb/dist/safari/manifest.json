{
    "manifest_version": 3,
    "name": "FocusUp for Canvas",
    "description": "Import your upcoming Canvas assignments into FocusUp's Quest Log from any computer.",
    "version": "1.2",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png",
        "256": "icons/icon-256.png",
        "512": "icons/icon-512.png"
    },
    "background": {
        "scripts": [
            "background.js"
        ],
        "type": "module",
        "persistent": false
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icons/icon-48.png"
    },
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "alarms"
    ],
    "optional_host_permissions": [
        "*://*/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "auth-callback.html",
                "auth-callback.js",
                "ext.js",
                "icons/icon-128.png"
            ],
            "matches": [
                "https://lpruhipiailgdjzgjdsc.supabase.co/*",
                "https://appleid.apple.com/*"
            ]
        }
    ]
}