{
    "manifest_version": 3,
    "name": "FocusUp for Canvas",
    "description": "Import your upcoming Canvas assignments into FocusUp's Quest Log from any computer.",
    "version": "1.2",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icons/icon-48.png"
    },
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "alarms",
        "identity"
    ],
    "optional_host_permissions": [
        "*://*/*"
    ]
}