# Copy this file to .env and fill in real values. .env itself is
# gitignored -- never commit real secrets.

PORT=3000

# Local Postgres, e.g. from `docker compose up -d` (see docker-compose.yml)
# or a native Postgres install (`brew install postgresql@16`).
DATABASE_URL=postgres://postgres:focusup@localhost:5432/focusup

# Any long random string for local dev is fine. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-real-random-secret

# Must match FocusUpSpike's bundle identifier in Xcode exactly -- Apple
# identity tokens are only valid for the app that requested them.
APPLE_BUNDLE_ID=com.scottgray.FocusUpSpike
