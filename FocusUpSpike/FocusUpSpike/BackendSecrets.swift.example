// Copy this file to BackendSecrets.swift (same folder) and fill in the two
// values from your Supabase project: Project Settings -> API.
//
// BackendSecrets.swift is gitignored, so your project URL stays out of the
// repo. This .example file is not compiled (wrong extension) -- only the
// copy is.
//
// The anon key is a PUBLIC key by design (it ships inside the app; Row
// Level Security in supabase/schema.sql protects the data), but never put
// the project's `service_role` key here or anywhere in the app.
enum BackendSecrets {
    static let projectURL = "https://YOUR-PROJECT-REF.supabase.co"
    static let anonKey = "YOUR-SUPABASE-ANON-KEY"
}
